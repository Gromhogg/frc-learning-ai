ANTHROPIC_API_KEY=your_key_here
JWT_SECRET=change-this-to-a-long-random-string

# The admin password. Anyone who enters it (with the Admin button) becomes an
# Admin, which lets them edit the AI's instructions and approve its
# suggestions. Everyone else is a Student. Admin access can't be removed in
# the app, so pick something students won't guess and only share it with
# mentors. (Old .env files may call this TEACHER_CODE — that still works.)
ADMIN_CODE=change-this-admin-password

# Only needed if you want "Continue with Google" to work.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Email for the 6-digit signup codes. If these are left out, the code is
# printed in the server log instead (fine for testing on your own computer).
#
# To send from a team Gmail account:
#   1. Sign in to the team Gmail and turn on 2-Step Verification
#      (Google Account > Security).
#   2. Create an "app password" (Google Account > Security > App passwords).
#      Google shows a 16-letter password once — copy it.
#   3. Remove the # from the lines below and fill them in: SMTP_USER is the
#      Gmail address, SMTP_PASS is the app password (not the normal Gmail
#      password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your-team-account@gmail.com
# SMTP_PASS=your-16-letter-app-password
# Optional: who the email says it's from. Defaults to SMTP_USER.
# EMAIL_FROM="972 Chat Bot <your-team-account@gmail.com>"
