ANTHROPIC_API_KEY=your_key_here
JWT_SECRET=change-this-to-a-long-random-string

# Anyone who enters this code becomes an Admin, which lets them edit the
# AI's instructions and approve its suggestions. Everyone else is a Student.
# Pick something students won't guess, and only share it with mentors.
ADMIN_CODE=change-this-admin-code

# Only needed if you want "Continue with Google" to work.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
