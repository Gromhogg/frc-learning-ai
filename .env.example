ANTHROPIC_API_KEY=your_key_here
JWT_SECRET=change-this-to-a-long-random-string

# Anyone who enters this code becomes a Teacher, which lets them edit the
# AI's instructions. Everyone else is a Student. Pick something students
# won't guess, and only share it with mentors.
TEACHER_CODE=change-this-teacher-code

# Only needed if you want "Continue with Google" to work.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
