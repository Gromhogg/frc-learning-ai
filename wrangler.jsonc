// Cloudflare setup for 972 Chat Bot: one Worker that serves the app and the
// API, with a D1 database, an R2 bucket for files, a queue for Slack work,
// and timed jobs. Secrets (API keys, passwords) are NOT kept here — set them
// with `npx wrangler secret put NAME` (or in `.env` for local dev).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatbot-972",
  // The Cloudflare account the app lives in. Remove this line to deploy to your own.
  "account_id": "ac884c4c755abc4f7ddc614c173baeca",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // No workers.dev address: people reach the app only through
  // https://chat972.pages.dev (see address/).
  "workers_dev": false,
  "preview_urls": false,

  // The React app. Anything that isn't a file falls back to index.html so
  // page links like /admin/facts work; these paths always go to the Worker.
  "assets": {
    "not_found_handling": "single-page-application",
    // "/auth/callback" is a page in the React app (where Google sign-in lands).
    "run_worker_first": ["/api/*", "/auth/*", "!/auth/callback", "/uploads/*", "/slack/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chatbot972",
      // From `npx wrangler d1 create chatbot972` (any value works locally).
      "database_id": "633e6f6f-655d-4f83-9c45-9263319cd41f",
      "migrations_dir": "drizzle"
    }
  ],

  "r2_buckets": [{ "binding": "FILES", "bucket_name": "chatbot972-files" }],

  // Sends the signup codes (see server/lib/email.ts). Only from EMAIL_FROM.
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["noreply@charliesweetland.com"] }],

  // Workers AI runs the free chat model (Gemma 4, see server/ai/free-model.ts)
  // and the mic button (OpenAI's Whisper turns speech into text). There's no
  // copy on your computer, so `npm run dev` uses the real one (needs
  // `npx wrangler login`). Free up to 10,000 "neurons" a day; a chat answer
  // is about 12, a minute of talking about 45.
  "ai": { "binding": "AI", "remote": true },

  "queues": {
    "producers": [{ "binding": "SLACK_QUEUE", "queue": "chatbot972-slack" }],
    "consumers": [{ "queue": "chatbot972-slack", "max_batch_size": 1, "max_retries": 2 }]
  },

  // Every 5 minutes: learn from quiet chats and Slack channels.
  // Every hour: the daily reviewer check and the Slack daily digest.
  "triggers": { "crons": ["*/5 * * * *", "0 * * * *"] },

  "vars": {
    // The app's public address (the Pages site in address/). On your own
    // computer, APP_URL in .env replaces this.
    "APP_URL": "https://chat972.pages.dev",
    // Signup codes come from this address (it must match send_email above).
    "EMAIL_FROM": "noreply@charliesweetland.com",
    "SMTP_HOST": "smtp.gmail.com",
    "SMTP_PORT": "465"
  }
}
