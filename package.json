    "@radix-ui/react-tooltip": "^1.4.1",
    "arctic": "^3.7.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.12",
    "jose": "^6.2.2",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
